---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} - TechBridge</title>
  </head>
  <body>
    
    <div class="bg-grid-pattern"></div>

    <Navbar />

    <main class="main-content">
      <slot />
    </main>

    <footer class="footer">
      <div class="container footer-container">
        <p>&copy; {new Date().getFullYear()} TechBridge. Construyendo autonomía digital.</p>
        <div class="footer-links">
          <a href="/privacy-consent.html">Privacidad y términos</a>
        </div>
      </div>
    </footer>

  </body>
</html>

<style>
  /* Patrón de líneas de fondo muy sutil */
  .bg-grid-pattern {
    position: absolute;
    inset: 0;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background-image: 
      linear-gradient(to right, rgba(0, 0, 0, 0.03) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(0, 0, 0, 0.03) 1px, transparent 1px);
    background-size: 40px 40px;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }

  body {
		font-family: var(--font-base);
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .main-content {
    flex: 1;
  }

  /* Footer moderno y limpio */
  .footer {
    background-color: #ffffff;
    border-top: 1px solid var(--color-border);
    padding: 2rem 0;
  }

  .footer-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
  }

  .footer p {
    font-size: 1rem;
    color: var(--color-text-muted);
  }

  .footer-links {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .footer-links a {
    font-size: 1rem;
    color: var(--color-text-dark);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .footer-links a:hover {
    color: var(--color-brand);
  }

  @media (min-width: 768px) {
    .footer-container {
      flex-direction: row;
      justify-content: space-between;
    }
  }
</style>
